### Create Alice
# @name createAlice
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "ownerId": "11111111-1111-1111-1111-111111111111",
  "type": "User",
  "currency": "VND"
}

### Create Bob
# @name createBob
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "ownerId": "22222222-2222-2222-2222-222222222222",
  "type": "User",
  "currency": "VND"
}

### Top up Alice from the seeded system account
POST {{baseUrl}}/topups
Content-Type: application/json
Idempotency-Key: topup-demo-001

{
  "accountId": "{{createAlice.response.body.$.id}}",
  "amount": 1000000,
  "currency": "VND",
  "reference": "topup-demo-001"
}

### Transfer Alice -> Bob
# @name transfer
POST {{baseUrl}}/transfers
Content-Type: application/json
Idempotency-Key: transfer-demo-001

{
  "fromAccountId": "{{createAlice.response.body.$.id}}",
  "toAccountId": "{{createBob.response.body.$.id}}",
  "amount": 250000,
  "currency": "VND",
  "reference": "transfer-demo-001"
}

### Retry the exact same transfer: returns the stored response
POST {{baseUrl}}/transfers
Content-Type: application/json
Idempotency-Key: transfer-demo-001

{
  "fromAccountId": "{{createAlice.response.body.$.id}}",
  "toAccountId": "{{createBob.response.body.$.id}}",
  "amount": 250000,
  "currency": "VND",
  "reference": "transfer-demo-001"
}

### Check Alice balance
GET {{baseUrl}}/accounts/{{createAlice.response.body.$.id}}/balance

### Read Alice ledger entries
GET {{baseUrl}}/accounts/{{createAlice.response.body.$.id}}/entries?limit=20
